{
  "name": "storyhunt-v3-subgraph",
  "version": "1.0.0",
  "repository": "https://github.com/0xstoryhunt/v3-subgraph.git",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "lint": "eslint . --ext .ts --fix",
    "build": "run-s codegen && graph build subgraph-aeneid.yaml",
    "build:mainnet": "run-s codegen:mainnet && graph build subgraph-mainnet.yaml",
    "build:sepolia": "run-s codegen:sepolia && graph build subgraph-sepolia.yaml",
    "build:docker": "docker build -t matchstick .",
    "codegen": "graph codegen subgraph-aeneid.yaml --output-dir src/types/",
    "codegen:mainnet": "graph codegen subgraph-mainnet.yaml --output-dir src/types/",
    "codegen:sepolia": "graph codegen subgraph-sepolia.yaml --output-dir src/types/",
    "test": "graph test -d",
    "test:no-tty": "docker run -i --rm --mount type=bind,source=$INIT_CWD,target=/matchstick matchstick",
    "deploy": "goldsky subgraph deploy storyhunt-subgraph-new/v1.0.11",
    "deploy:sepolia": "run-s build:sepolia deploy:sepolia:built",
    "deploy:sepolia:built": "goldsky subgraph deploy storyhunt-subgraph-ethereum-sepolia/v0.1.0 --path build",
    "deploy:graft": "goldsky subgraph deploy storyhunt-subgraph-new/v1.0.11 --graft-from storyhunt-subgraph-new/v1.0.10"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.98.1",
    "@graphprotocol/graph-ts": "^0.38.2",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^6.1.0",
    "matchstick-as": "^0.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^1.18.2",
    "typescript": "^3.5.2"
  },
  "dependencies": {
    "@storyhunt/default-list": "^1.0.4"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
